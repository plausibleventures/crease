{
  "name": "printstudio",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "homepage": "https://crease.plausible.ventures",
  "repository": "https://github.com/plausibleventures/crease",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web,printer -c blue,green,magenta \"npm:dev:server\" \"npm:dev:web\" \"npm:mock:printer\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "mock:printer": "tsx tools/mock-moonraker.ts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:electron:main": "node electron/build.mjs",
    "dev:electron": "npm run build:electron:main && concurrently -k -n web,printer,electron -c green,magenta,cyan \"npm:dev:web\" \"npm:mock:printer\" \"PRINTSTUDIO_DEV_URL=http://localhost:5173 electron .\"",
    "build:electron": "vite build && node electron/build.mjs",
    "start:electron": "electron .",
    "notices": "tsx tools/notices.ts",
    "dist:mac": "npm run notices && npm run build:electron && electron-builder --mac --config electron-builder.config.cjs",
    "icon": "node -e \"require('sharp')('build/icon.png').resize(192,192).png().toFile('public/brand/crease-mark.png')\"",
    "eval": "tsx tools/evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@anthropic-ai/sdk": "^0.131.0",
    "@base-ui/react": "^1.8.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron-updater": "^6.8.9",
    "fastify": "^5.12.5",
    "lucide-react": "^1.52.0",
    "manifold-3d": "^3.5.4",
    "monaco-editor": "^0.57.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.3",
    "sharp": "^0.35.5",
    "simple-git": "^4.0.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^10.0.5",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.3"
  },
  "main": "dist-electron/main.mjs",
  "description": "Describe it. Print it. Put it together. A desktop studio that designs, checks, slices and prints 3D models with Claude.",
  "author": "Aniruddh Chandratre"
}
